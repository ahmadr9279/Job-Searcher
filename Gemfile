source "https://rubygems.org"

# Specify a modern Ruby version (adjust if you have a different version installed locally)
ruby '3.3.0'

# Core framework and server
gem 'sinatra', '~> 4.0'
gem 'puma'

# Environment variables for your API keys
gem 'dotenv'

# The API client
gem 'careerjet-api-client', require: "careerjet/api_client"

# Development tools grouped together
group :development do
  gem 'pry'
  gem 'sinatra-contrib'
end
