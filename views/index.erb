<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Job finder</title>
    <!-- bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <!-- jQuery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
    <!-- bootstrap JS -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    
    <!-- custom css -->
    <link rel="stylesheet" href="css/style.css" type="text/css">
    <style>
    </style>
    <!-- custom JS -->
    <script src="js/script.js"></script>
  </head>
  <body>
    <div class="container-fluid">
      
      <!-- Updated Giphy embed wrapped to maintain center styling -->
      <div style="max-width: 480px; margin: 0 auto;" class="center">
        <div style="width:100%;height:0;padding-bottom:100%;position:relative;">
          <iframe src="https://giphy.com/embed/l1IYhmLyuCfgPL16g" width="100%" height="100%" style="position:absolute; top:0; left:0;" frameBorder="0" class="giphy-embed" allowFullScreen></iframe>
        </div>
      </div>
      
      <h1 class="text">Job Finder</h1>
      <h3 class="text">Enter the type of job you want to search for</h3>
      
      <form method="post" action="/result">
        <!--<label for="keyword"><label>-->
        <p class="text" >Job: <input type="text" name="keyword" size="30" placeholder="software engineer"><br></p>
        <p class="text">Area: <input type="text" name="location" size="30" placeholder="Brooklyn, New York"></p>
        
        <p class="center"><input type="submit" value="Search"></p>
      </form>
    </div>
  </body>
</html>
